{
  "name": "vp-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:lint:ci": "actionlint",
    "agent:lint:fix": "vp check --fix && node scripts/lint-tailwind.ts --fix",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "agent:test:e2e": "vp test run --project client --reporter=tap-flat --no-color",
    "agent:test:unit": "vp test run --project server --reporter=tap-flat --no-color",
    "agent:verify:gate": "npm run agent:verify:unit && npm run build && npm run agent:test:e2e",
    "agent:verify:inner": "npm run typecheck && npm run lint && npm run agent:lint:tailwind",
    "agent:verify:unit": "npm run agent:verify:inner && npm run agent:test:unit",
    "build": "vp build",
    "check": "vp check",
    "check:deadcode": "knip",
    "check:fast": "npm run typecheck && npm run lint && npm run agent:test:unit",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/server/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "deploy:cf": "wrangler deploy",
    "dev": "vp dev",
    "docker:build": "docker build -t vp-hono:latest .",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:ci": "actionlint",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "preview": "vp preview",
    "routes:generate": "node scripts/generate-routes.ts",
    "scaffold:feature": "node scripts/scaffold-feature.ts",
    "start": "node dist/server/app.js",
    "test": "vp test run",
    "test:e2e": "vp test run --project client",
    "test:setup": "playwright install chromium",
    "test:unit": "vp test run --project server",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run typecheck && npm run check && npm run agent:lint:tailwind && npm run check:deadcode && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@hono/zod-openapi": "1.6.3",
    "@internationalized/date": "3.12.4",
    "@libsql/client": "0.18.0",
    "@scalar/hono-api-reference": "0.12.22",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "bcrypt-ts": "9.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "hono": "4.13.19",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-generator": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "knip": "6.45.1",
    "oxc-transform-react": "0.156.0",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0",
    "vscode-languageserver-protocol": "3.18.5",
    "wrangler": "4.164.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "26.13.1"
  },
  "knip": {
    "ignore": [
      "src/client/routeTree.gen.ts",
      "src/client/components/ui/**"
    ],
    "ignoreBinaries": [
      "actionlint"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server",
      "@internationalized/date",
      "@tanstack/react-table"
    ],
    "playwright": true
  }
}
